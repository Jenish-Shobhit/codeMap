# Broken variants of `follow` in src/ui/mod.rs. Each must make the harness it
# names fail: `python3 scripts/kani.py mutations`. Format: agent-formal-verify.

mutation no clamp at the right edge
detects ui::proofs::follow_never_scrolls_past_the_content
-     scroll.0 = scroll.0.min(content.0.saturating_sub(vw.min(content.0)));
+     scroll.0 = scroll.0.min(content.0);

mutation bottom clamp one row too far
detects ui::proofs::follow_never_scrolls_past_the_content
-     scroll.1 = scroll.1.min(content.1.saturating_sub(vh.min(content.1)));
+     scroll.1 = scroll.1.min(content.1.saturating_sub(vh.min(content.1)) + 1);

mutation right margin wider than a fitting box allows
detects ui::proofs::follow_shows_a_box_that_fits
-         scroll.0 = (x + w.min(vw)).saturating_sub(vw) + 2;
+         scroll.0 = (x + w.min(vw)).saturating_sub(vw) + 3;

mutation scrolling up past the box's top row
detects ui::proofs::follow_shows_a_box_that_fits
-         scroll.1 = y.saturating_sub(1);
+         scroll.1 = y + 1;

mutation a box one column past the right edge counts as visible
detects ui::proofs::follow_shows_a_box_that_fits
-     } else if x + w.min(vw) > scroll.0 + vw {
+     } else if x + w.min(vw) > scroll.0 + vw + 1 {
