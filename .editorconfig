# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,svg}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Golden frames and fixtures are compared byte for byte.
[tests/{snapshots,fixtures}/**]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
